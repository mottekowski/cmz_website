---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { hero, about, topics, signals, contact } from '../data/content';
import { site, artwork } from '../config/site';
---
<Layout>
  <div class="hero-shell" id="start">
    <img class="hero-art" src={artwork.hero} alt="" width="1600" height="1000" fetchpriority="high" />
    <Header home />
    <main id="inhalt">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow" lang="en"><span></span>{hero.label}</p>
          <h1 id="hero-title" lang="en"><span>BETWEEN</span>{' '}<span>SIGNAL</span>{' '}<span class="hero-accent">AND NOISE.</span></h1>
          <p class="hero-intro">{hero.intro}</p>
          <div class="hero-actions">
            <a class="button" href="#themen">MEINE WELT ENTDECKEN <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#ueber-mich">ÜBER MICH</a>
          </div>
          <ul class="hero-topics" aria-label="Interessengebiete">{hero.topics.map(topic => <li>{topic}</li>)}</ul>
        </div>
        <a class="scroll-note" href="#ueber-mich" aria-label="Weiter zu Über mich"><span aria-hidden="true">WEITER</span><span aria-hidden="true">↓</span></a>
      </section>
      <section id="ueber-mich" class="section about-section" aria-labelledby="about-title">
        <div class="wrap about-grid">
          <div class="about-copy">
            <SectionHeading number="02" id="about-title" first="BEYOND" second="THE SIGNAL." />
            {about.map((paragraph, index) => <p class:list={[index === 0 && 'lead']}>{paragraph}</p>)}
            <blockquote>Nicht alles braucht ein Ziel.<br />Manches darf einfach faszinieren.</blockquote>
          </div>
          <figure class="about-art">
            <img src={artwork.about} width="700" height="850" alt="" loading="lazy" decoding="async" />
            <figcaption><span lang="en">STRUCTURE MEETS POSSIBILITY</span><span aria-hidden="true">02 — CZ</span></figcaption>
          </figure>
        </div>
      </section>
      <section id="themen" class="section topics-section" aria-labelledby="topics-title">
        <div class="wrap">
          <div class="section-topline">
            <SectionHeading number="03" id="topics-title" first="SAME CURIOSITY." second="DIFFERENT FIELDS." />
            <p>Vier Themenwelten. Unterschiedliche Perspektiven.<br />Ein gemeinsamer Antrieb: Neugier.</p>
          </div>
          <div class="topic-grid">
            {topics.map(topic => <article class="topic-card" id={topic.id} aria-labelledby={`${topic.id}-title`}>
              <img src={topic.image} alt="" width="600" height="360" loading="lazy" decoding="async" />
              <div class="card-copy">
                <p class="eyebrow" lang="en">{topic.category}</p>
                <h3 id={`${topic.id}-title`} lang="en">{topic.title}</h3>
                <p class="card-subtitle" lang="en">{topic.subtitle}</p>
                <p>{topic.body}</p>
                <span class="card-end" aria-hidden="true"></span>
              </div>
            </article>)}
          </div>
        </div>
      </section>
      <section id="impulse" class="section signals-section" aria-labelledby="signals-title">
        <div class="wrap">
          <div class="section-topline">
            <SectionHeading number="04" id="signals-title" first="SELECTED" second="SIGNALS." />
            <p>Ideen, Experimente und persönliche Fundstücke.<br />Drei Konzepte, die hier nach und nach Raum finden.</p>
          </div>
          <div class="signal-grid">
            {signals.map(signal => <article class="signal-card">
              <img src={signal.image} alt="" width="600" height="360" loading="lazy" decoding="async" />
              <div class="card-copy">
                <p class="eyebrow" lang="en">{signal.category}</p>
                <h3 lang="en">{signal.title}</h3>
                <p>{signal.body}</p>
                <p class="coming-later"><span aria-hidden="true"></span>Konzept · Inhalte folgen</p>
              </div>
            </article>)}
          </div>
        </div>
      </section>
      <section id="kontakt" class="section contact-section" aria-labelledby="contact-title">
        <div class="wrap contact-grid">
          <SectionHeading number="05" id="contact-title" first="STAY CURIOUS." second="STAY CONNECTED." />
          <div class="contact-copy">
            <p>{contact}</p>
            {site.email ? <a class="button" href={`mailto:${site.email}`}>KONTAKT AUFNEHMEN <span aria-hidden="true">↗</span></a> : <>
              <button class="button" type="button" disabled aria-describedby="contact-pending">KONTAKT AUFNEHMEN <span aria-hidden="true">↗</span></button>
              <p class="contact-pending" id="contact-pending">Kontaktadresse folgt. Im lokalen Entwurf noch nicht verfügbar.</p>
            </>}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>

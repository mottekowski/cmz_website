---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
const fields = [
  ['Verantwortliche Person', site.legal.responsibleName],
  ['Straße und Hausnummer', site.legal.streetAndNumber],
  ['Postleitzahl und Ort', site.legal.postalCodeAndCity],
  ['Land', site.legal.country],
  ['E-Mail', site.email],
  ['Weitere erforderliche Angaben', site.legal.additionalRequiredInformation],
];
---
<Layout title="Impressum — Christoph Zink" noindex>
  <div id="start"><Header /></div>
  <main id="inhalt" class="legal-page wrap">
    <p class="eyebrow">LOKALER ENTWURF</p>
    <h1>Impressum</h1>
    <p class="legal-notice">Nicht veröffentlichungsfähig. Die Angaben müssen vom Websiteinhaber ergänzt und vor Veröffentlichung geprüft werden.</p>
    <dl>{fields.map(([label, value]) => <div><dt>{label}</dt><dd>{value ?? 'OFFEN — Angabe des Websiteinhabers erforderlich'}</dd></div>)}</dl>
    <a class="text-link" href="/">ZURÜCK ZUR STARTSEITE</a>
  </main>
  <Footer />
</Layout>

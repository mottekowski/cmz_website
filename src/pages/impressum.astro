---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

const legal = site.legal;
const pending = 'OFFEN — vor Veröffentlichung ergänzen';
---
<Layout title="Impressum — Christoph Zink" noindex>
  <div id="start"><Header /></div>
  <main id="inhalt" class="legal-page wrap">
    <p class="eyebrow">RECHTLICHE INFORMATIONEN</p>
    <h1>Impressum</h1>
    <p class="legal-notice">Arbeitsentwurf – noch nicht zur Veröffentlichung geeignet. Es fehlen verbindliche Angaben des Websitebetreibers und eine abschließende rechtliche Prüfung.</p>

    <h2>Anbieterkennzeichnung</h2>
    <dl>
      <div><dt>Name</dt><dd>{legal.responsibleName ?? site.name}</dd></div>
      <div><dt>Ladungsfähige Anschrift</dt><dd>{legal.streetAndNumber ?? pending}<br />{legal.postalCodeAndCity ?? pending}<br />{legal.country ?? pending}</dd></div>
      <div><dt>Kontakt per E-Mail</dt><dd>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : pending}</dd></div>
      {legal.additionalRequiredInformation && <div><dt>Weitere gesetzliche Angaben (falls einschlägig)</dt><dd class="preserve-lines">{legal.additionalRequiredInformation}</dd></div>}
    </dl>

    <h2>Inhaltlich verantwortlich</h2>
    <p>Für eventuell journalistisch-redaktionelle Inhalte ist vor der Veröffentlichung zu prüfen, ob eine gesonderte Angabe nach § 18 Abs. 2 Medienstaatsvertrag erforderlich ist. Die verantwortliche Person und ihre Anschrift sind dann vollständig zu nennen.</p>

    <p>Die Angaben dieser Seite sind vor der Freischaltung auf Vollständigkeit und Richtigkeit zu prüfen.</p>
    <a class="text-link" href="/">ZURÜCK ZUR STARTSEITE</a>
  </main>
  <Footer />
</Layout>

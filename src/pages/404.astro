---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Seite nicht gefunden — CURIOUS CURRENT" noindex>
  <div id="start"><Header /></div>
  <main class="legal-page wrap" id="inhalt">
    <p class="eyebrow">404</p>
    <h1 lang="en">LOST IN THE NOISE.</h1>
    <p>Diese Seite gibt es hier nicht.</p>
    <a class="button" href="/">ZUR STARTSEITE <span aria-hidden="true">↗</span></a>
  </main>
  <Footer />
</Layout>

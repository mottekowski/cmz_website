---
import type { SonicExperiment as Experiment } from '../data/content';
interface Props { experiment: Experiment }
const { experiment } = Astro.props;
---
<article class="sonic-experiment" aria-labelledby={`experiment-${experiment.id}-title`} data-sonic-experiment>
  <div class="soundscape" data-soundscape><canvas data-orbit-canvas aria-hidden="true"></canvas><div class="soundscape-caption"><span>LIVE SIGNAL</span><span data-visual-state>AMBIENT</span></div></div>
  <div class="experiment-content">
    <header class="experiment-intro"><p class="eyebrow" lang="en">EXPERIMENT {experiment.id} / {experiment.category}</p><h2 id={`experiment-${experiment.id}-title`} lang="en">{experiment.title}</h2><p>{experiment.description}</p></header>
    <div class="audio-player" data-player><audio preload="metadata" src={experiment.audioSrc} data-audio></audio><div class="player-main"><button class="play-button" type="button" data-play aria-label="Wiedergabe starten"><span data-play-icon aria-hidden="true">▶</span></button><div class="timeline-wrap"><input class="timeline" data-seek type="range" min="0" max="0" value="0" step="0.01" aria-label="Wiedergabeposition" /><div class="timecode"><span data-current>0:00</span><span aria-hidden="true">/</span><span data-duration>0:00</span></div></div><label class="volume-control"><span aria-hidden="true">VOL</span><input data-volume type="range" min="0" max="1" step="0.01" value="1" aria-label="Lautstärke" /></label></div><button class="visual-toggle" type="button" data-visual-toggle aria-pressed="true">VISUALISIERUNG: AN</button></div>
    <div class="experiment-details"><div><p class="eyebrow">EXPERIMENT</p><p>{experiment.id}</p></div><div><p class="eyebrow">CREATED WITH</p><p>{experiment.tool}</p></div><div><p class="eyebrow">FORMAT</p><p>Sonic Experiment</p></div><div><p class="eyebrow">DURATION</p><p data-metadata-duration>–</p></div></div>
    <section class="emergence" aria-labelledby={`emerged-${experiment.id}`}><p class="eyebrow">HOW IT EMERGED</p><h3 id={`emerged-${experiment.id}`}>Zwischen Code und Impuls.</h3><p>{experiment.emerged}</p></section>
  </div>
</article>

<script>
  const formatTime = (seconds: number) => Number.isFinite(seconds) ? `${Math.floor(seconds / 60)}:${Math.floor(seconds % 60).toString().padStart(2, '0')}` : '0:00';
  document.querySelectorAll<HTMLElement>('[data-sonic-experiment]').forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!, play = root.querySelector<HTMLButtonElement>('[data-play]')!, icon = root.querySelector<HTMLElement>('[data-play-icon]')!, seek = root.querySelector<HTMLInputElement>('[data-seek]')!, volume = root.querySelector<HTMLInputElement>('[data-volume]')!, current = root.querySelector<HTMLElement>('[data-current]')!, duration = root.querySelector<HTMLElement>('[data-duration]')!, metadataDuration = root.querySelector<HTMLElement>('[data-metadata-duration]')!, canvas = root.querySelector<HTMLCanvasElement>('[data-orbit-canvas]'), state = root.querySelector<HTMLElement>('[data-visual-state]')!, toggle = root.querySelector<HTMLButtonElement>('[data-visual-toggle]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)'), ctx = canvas?.getContext('2d'), values = new Uint8Array(256);
    let audioContext: AudioContext | undefined, analyser: AnalyserNode | undefined, frame = 0, enabled = !reduced.matches, visible = true, lastTime = 0;
    let bass = 0, mid = 0, high = 0, energy = 0, pulse = 0;
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const approach = (currentValue: number, target: number, rate: number, dt: number) => currentValue + (target - currentValue) * (1 - Math.exp(-rate * dt));
    const graph = () => { if (!ctx || !window.AudioContext) return; if (!audioContext) { audioContext = new AudioContext(); analyser = audioContext.createAnalyser(); analyser.fftSize = 512; analyser.minDecibels = -92; analyser.maxDecibels = -18; analyser.smoothingTimeConstant = .56; const source = audioContext.createMediaElementSource(audio); source.connect(analyser); analyser.connect(audioContext.destination); } if (audioContext.state === 'suspended') audioContext.resume(); };
    const resize = () => { if (!canvas || !ctx) return; const b = canvas.getBoundingClientRect(), r = Math.min(devicePixelRatio || 1, 2); canvas.width = Math.max(1, Math.round(b.width * r)); canvas.height = Math.max(1, Math.round(b.height * r)); ctx.setTransform(r, 0, 0, r, 0, 0); };
    const band = (from: number, to: number) => { let sum = 0; for (let i = from; i < to; i++) sum += values[i] / 255; return sum / (to - from); };
    const draw = (time = 0) => {
      if (!canvas || !ctx) return;
      const dt = Math.min(.05, lastTime ? (time - lastTime) / 1000 : 1 / 60); lastTime = time;
      const b = canvas.getBoundingClientRect(), active = !audio.paused && analyser && enabled;
      let targetBass = 0, targetMid = 0, targetHigh = 0;
      if (active && analyser) { analyser.getByteFrequencyData(values); targetBass = clamp(Math.pow(band(1, 22) * 1.62, .72)); targetMid = clamp(Math.pow(band(22, 105) * 1.44, .82)); targetHigh = clamp(Math.pow(band(105, 220) * 1.72, .9)); }
      bass = approach(bass, targetBass, targetBass > bass ? 15 : 2.25, dt); mid = approach(mid, targetMid, targetMid > mid ? 10 : 1.8, dt); high = approach(high, targetHigh, targetHigh > high ? 20 : 3.4, dt);
      energy = approach(energy, clamp(bass * .54 + mid * .32 + high * .14), active ? 5.4 : 1.25, dt); pulse = approach(pulse, bass, bass > pulse ? 24 : 4.4, dt);
      ctx.clearRect(0, 0, b.width, b.height);
      const x = b.width * (.52 + Math.sin(time / 9400) * .025 * (1 + mid)), y = b.height * (.51 + Math.cos(time / 7800) * .026 * (1 + bass));
      const ambient = enabled && !reduced.matches ? .35 + Math.sin(time / 4100) * .16 : 0;
      const glow = ctx.createRadialGradient(x, y, 0, x, y, Math.max(b.width, b.height) * (.38 + pulse * .18)); glow.addColorStop(0, `rgba(217,119,6,${.038 + energy * .15})`); glow.addColorStop(.48, `rgba(217,119,6,${.016 + mid * .06})`); glow.addColorStop(1, 'rgba(217,119,6,0)'); ctx.fillStyle = glow; ctx.fillRect(0, 0, b.width, b.height);
      const motion = reduced.matches ? .09 : active ? .58 + energy * 1.5 : .1 + ambient * .16;
      for (let i = 0; i < 9; i++) {
        const phase = i * 1.71, direction = i % 2 ? 1 : -1, speed = (.07 + i * .018 + pulse * .1) * direction * motion;
        const angle = phase + time / 1000 * speed + Math.sin(time / 1700 + phase) * (.1 + mid * .26);
        const expansion = 1 + pulse * (.13 + i * .014) + Math.sin(time / 1200 + phase) * (.025 + mid * .055);
        const rx = b.width * (.105 + i * .035) * expansion * (1 + Math.sin(time / 2100 + phase) * (.055 + mid * .13));
        const ry = b.height * (.08 + i * .027) * (1 + bass * .2 + Math.cos(time / 1650 + phase) * (.06 + mid * .17));
        const orbitX = x + Math.sin(time / (1300 + i * 195) + phase) * b.width * (.012 + mid * .042);
        const orbitY = y + Math.cos(time / (1570 + i * 140) + phase) * b.height * (.011 + bass * .034);
        ctx.save(); ctx.translate(orbitX, orbitY); ctx.rotate(angle); ctx.beginPath();
        for (let s = 0; s <= 128; s++) { const a = s / 128 * Math.PI * 2; const warp = 1 + Math.sin(a * (2 + i % 4) + time / (440 - high * 130) + phase) * (.018 + mid * .17) + Math.sin(a * 7 - time / 720) * high * .045; const px = Math.cos(a) * rx * warp; const py = Math.sin(a) * ry * (1 + Math.sin(a * 3 + phase) * mid * .1) * warp; if (s) ctx.lineTo(px, py); else ctx.moveTo(px, py); }
        ctx.strokeStyle = `rgba(230,163,87,${.1 + i * .012 + energy * .2})`; ctx.lineWidth = .55 + high * .78; ctx.shadowBlur = 2 + high * 13 + pulse * 6; ctx.shadowColor = 'rgba(217,119,6,.6)'; ctx.stroke(); ctx.restore();
      }
      for (let i = 0; i < 18; i++) { const phase = i * 2.399, a = phase + time / 1000 * (.16 + high * .65) * (i % 2 ? 1 : -1), radius = Math.min(b.width, b.height) * (.1 + (i % 6) * .046) * (1 + pulse * .23); ctx.fillStyle = `rgba(232,232,228,${.035 + high * .34})`; ctx.beginPath(); ctx.arc(x + Math.cos(a) * radius, y + Math.sin(a) * radius * (.48 + mid * .1), .45 + high * 1.7, 0, Math.PI * 2); ctx.fill(); }
      if (visible && (active || enabled && !reduced.matches || bass + mid + high > .01)) frame = requestAnimationFrame(draw);
    };
    const render = () => { cancelAnimationFrame(frame); draw(performance.now()); }; new ResizeObserver(() => { resize(); render(); }).observe(root.querySelector<HTMLElement>('[data-soundscape]')!); new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) render(); }, { threshold: .01 }).observe(root);
    audio.addEventListener('loadedmetadata', () => { seek.max = String(audio.duration); duration.textContent = formatTime(audio.duration); metadataDuration.textContent = formatTime(audio.duration); }); audio.addEventListener('timeupdate', () => { seek.value = String(audio.currentTime); current.textContent = formatTime(audio.currentTime); }); audio.addEventListener('play', () => { icon.textContent = 'Ⅱ'; play.setAttribute('aria-label', 'Wiedergabe pausieren'); state.textContent = enabled ? 'REACTIVE' : 'OFF'; render(); }); audio.addEventListener('pause', () => { icon.textContent = '▶'; play.setAttribute('aria-label', 'Wiedergabe starten'); state.textContent = enabled ? 'AMBIENT' : 'OFF'; render(); }); audio.addEventListener('ended', () => { seek.value = '0'; current.textContent = '0:00'; });
    play.addEventListener('click', async () => { if (audio.paused) { graph(); await audio.play(); } else audio.pause(); }); seek.addEventListener('input', () => { audio.currentTime = Number(seek.value); current.textContent = formatTime(audio.currentTime); }); volume.addEventListener('input', () => { audio.volume = Number(volume.value); }); toggle.addEventListener('click', () => { enabled = !enabled; toggle.setAttribute('aria-pressed', String(enabled)); toggle.textContent = `VISUALISIERUNG: ${enabled ? 'AN' : 'AUS'}`; state.textContent = enabled && !audio.paused ? 'REACTIVE' : enabled ? 'AMBIENT' : 'OFF'; render(); }); reduced.addEventListener('change', (event) => { if (event.matches) { enabled = false; toggle.setAttribute('aria-pressed', 'false'); toggle.textContent = 'VISUALISIERUNG: AUS'; state.textContent = 'OFF'; } render(); }); resize(); render();
  });
</script>

# Apache: HTTPS for the sole production hostname and the generated static error page.
RewriteEngine On
# Keep the target explicit: do not reflect arbitrary Host headers and do not
# add redirects for legacy or www hostnames.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^curiouscurrent\.xyz$ [NC]
RewriteRule ^ https://curiouscurrent.xyz%{REQUEST_URI} [R=301,L,NE]

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Public draft only. Remove after explicit approval of the final release.
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
